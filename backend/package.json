  "version": "1.0.0",
  "description": "BELLMAK E-Commerce Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "npx prisma generate && npx esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:@prisma/client --external:prisma",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [],
